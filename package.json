{
  "name": "pdf2plt",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "cli": "pnpm --filter @pdf2plt/cli cli",
    "dev": "pnpm --filter @pdf2plt/desktop dev",
    "build": "pnpm -r build",
    "release:cli": "pnpm --filter @pdf2plt/cli release:linux",
    "smoke:pdf": "pnpm --filter @pdf2plt/core smoke:pdf",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "tauri": "pnpm --filter @pdf2plt/desktop tauri"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
