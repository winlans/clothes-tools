{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pdf2plt",
  "version": "0.1.6",
  "identifier": "dev.pdf2plt.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "pdf2plt",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "publisher": "pdf2plt contributors",
    "copyright": "Copyright © 2026 pdf2plt contributors",
    "license": "AGPL-3.0-or-later",
    "licenseFile": "../../../LICENSE",
    "category": "GraphicsAndDesign",
    "shortDescription": "Visual PDF sewing-pattern layout and SVG export tool",
    "longDescription": "Arrange tiled garment-pattern PDF pages visually and export a single editable, full-size vector SVG.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../LICENSE": "LICENSE",
      "../../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../../../SOURCE_OFFER.md": "SOURCE_OFFER.md",
      "../../../docs/USER_GUIDE.md": "USER_GUIDE.md"
    }
  }
}
